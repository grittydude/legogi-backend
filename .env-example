# Copy this file to `.env` and change what you need:
#
#     cp .env-example .env
#
# `.env` is git-ignored. Never commit real secrets. Every value below is
# optional: leave it out, or leave it empty, and the default in
# app/core/config.py is used.

# Shown in the API docs and returned by GET /api/v1/version.
PROJECT_NAME="L'egogi API"
VERSION=0.1.0

# One of: local, staging, production.
ENVIRONMENT=local

# Prefix for every versioned endpoint.
API_V1_STR=/api/v1
