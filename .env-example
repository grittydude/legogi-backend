# Copy this file to `.env` and change what you need:
#
#     cp .env-example .env
#
# `.env` is git-ignored. Never commit real secrets. Every value below is
# optional: leave it out, or leave it empty, and the default in
# app/core/config.py is used.

# Shown in the API docs and returned by GET /api/v1/version.
PROJECT_NAME="L'egogi API"
VERSION=0.1.0

# One of: local, staging, production.
ENVIRONMENT=local

# Prefix for every versioned endpoint.
API_V1_STR=/api/v1

# --- Local services (compose.yml) ---------------------------------------------
# Docker Compose reads these to set up its containers. The API ignores them
# until the PR that first uses each service adds it to Settings.

# Postgres
POSTGRES_USER=legogi
POSTGRES_PASSWORD=legogi
POSTGRES_DB=legogi

# S3-compatible storage (SeaweedFS locally, Cloudflare R2 in production)
S3_ACCESS_KEY_ID=legogi
S3_SECRET_ACCESS_KEY=legogi-secret
S3_BUCKET=legogi-backups
